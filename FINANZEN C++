// FinanZen — módulo 1 (Joaquín 1): usuarios y autenticación · integrado con ayuda de Claude Code (IA)
// Lógica tomada de originales/usuarios_joaquin1.cpp. Los cin/cout originales
// quedaron en consola/menu_usuarios.cpp; aquí solo queda la lógica.

// Arreglos globales (originales)
string usu[MAX];
string con[MAX];
int total = 0;

// Agregados para unir los módulos
int usuId[MAX];
int proximoId = 1;
int sesion = -1;

// Agregado: Busca un nombre en usu[]; devuelve la posición o -1 (apoyo para no repetir nombres)
int buscarUsuario(string nombre)
{
    for (int i = 0; i < total; i++)
    {
        if (usu[i] == nombre)
        {
            return i;
        }
    }
    return -1;
}

// Origen: registrar() — Joaquín 1
bool registrar(string nombre, string clave)
{
    if (total >= MAX)
    {
        return false; // "No hay espacio para mas usuarios"
    }
    if (!textoValido(nombre) || !claveValida(clave))
    {
        return false;
    }
    if (buscarUsuario(nombre) != -1)
    {
        return false; // Corregido: el original permitía dos usuarios con el mismo nombre
    }

    usu[total] = nombre;
    con[total] = clave;
    usuId[total] = proximoId;
    proximoId++;

    reiniciarMetaUsuario(total);   // módulo de Hector: la posición empieza sin meta
    reiniciarLimiteUsuario(total); // módulo de Joaquín 2: sin límite de gasto

    total++;
    return true; // "Usuario registrado correctamente"
}

// Origen: iniciar() — Joaquín 1
bool iniciar(string nombre, string clave)
{
    bool encontrado = false;

    for (int i = 0; i < total; i++)
    {
        if (usu[i] == nombre && con[i] == clave)
        {
            encontrado = true;
            sesion = usuId[i];
            break;
        }
    }

    return encontrado;
}

// Agregado: cierra la sesión actual
void cerrarSesion()
{
    sesion = -1;
}

// Agregado: Posición en usu[] del usuario conectado (-1 si no hay sesión)
int indiceSesion()
{
    for (int i = 0; i < total; i++)
    {
        if (usuId[i] == sesion)
        {
            return i;
        }
    }
    return -1;
}

// Agregado: nombre del usuario conectado
string nombreSesion()
{
    int p = indiceSesion();
    if (p == -1)
    {
        return "";
    }
    return usu[p];
}

// Origen: modificar() — Joaquín 1 (pos empieza en 0; el original usaba p - 1)
bool modificar(int pos, string nombre, string clave)
{
    if (pos < 0 || pos >= total || pos != indiceSesion()) // agregado: solo la propia cuenta
    {
        return false; // "Usuario no encontrado"
    }
    if (!textoValido(nombre) || !claveValida(clave))
    {
        return false;
    }
    int otro = buscarUsuario(nombre);
    if (otro != -1 && otro != pos)
    {
        return false;
    }

    usu[pos] = nombre;
    con[pos] = clave;
    return true; // "Usuario modificado correctamente"
}

// Origen: borrar() — Joaquín 1
bool borrar(int pos)
{
    if (pos < 0 || pos >= total || pos != indiceSesion()) // agregado: solo la propia cuenta
    {
        return false; // "Usuario no encontrado"
    }

    int id = usuId[pos];
    borrarDatosDeUsuario(pos); // agregado: borra sus ingresos, gastos, meta y ahorros

    for (int i = pos; i < total - 1; i++)
    {
        usu[i] = usu[i + 1];
        con[i] = con[i + 1];
        usuId[i] = usuId[i + 1];
    }

    total--;

    if (sesion == id)
    {
        sesion = -1;
    }
    return true; // "Usuario eliminado correctamente"
}


// ----- motor/cifrado.cpp -----

// FinanZen — cifrado de contraseñas · integrado con ayuda de Claude Code (IA)
// Origen: el ejemplo de cifrado del equipo (sumar una llave a cada letra para cifrar,
// restarla para descifrar). Se usa al guardar y leer usuarios.txt, así las
// contraseñas no se pueden leer abriendo el archivo.
//
// Por qué la llave es 100: las contraseñas solo tienen letras sin tilde, números y
// símbolos (códigos 32 a 126). Sumando 100, todas quedan entre 132 y 226, fuera de
// las letras normales. Así el cifrado nunca produce un '|' (que separa los campos
// del archivo) ni un salto de línea.

// Origen: BLOQUE 2: CIFRADO del ejemplo del equipo
string cifrar(string mensaje, int llaveCifrado)
{
    string cifrado = mensaje;
    for (int i = 0; i < (int)cifrado.length(); i++)
    {
        cifrado[i] = cifrado[i] + llaveCifrado;
    }
    return cifrado;
}

// Origen: BLOQUE 3: DESCIFRADO del ejemplo del equipo
string descifrar(string cifrado, int llaveDescifrado)
{
    string descifrado = cifrado;
    for (int i = 0; i < (int)descifrado.length(); i++)
    {
        descifrado[i] = descifrado[i] - llaveDescifrado;
    }
    return descifrado;
}

// Agregado: una contraseña válida tiene solo letras sin tilde, números, espacios y símbolos
// (sin '|'), y no puede estar vacía.
bool claveValida(string clave)
{
    if (!textoValido(clave))
    {
        return false;
    }
    for (int i = 0; i < (int)clave.length(); i++)
    {
        unsigned char c = clave[i];
        if (c < 32 || c > 126)
        {
            return false; // tildes, ñ y otros caracteres especiales
        }
    }
    return true;
}


