#include <iostream>
#include <math.h>
using namespace std;
int main()
{
    float x1,x2,y1,y2,d;
    cout<<"Ingrese x1: ";
    cin>>x1;
    cout<<"Ingrese y1: ";
    cin>>y1;
    cout<<"Ingrese x2: ";
    cin>>x2;
    cout<<"Ingrese y2: ";
    cin>>y2;
    d=sqrt(pow((x2-x1),2)+pow((y2-y1),2));
    cout<<"La distancia entre los dos puntos es de: "<<d<<" unidades";
    return 0;
}
