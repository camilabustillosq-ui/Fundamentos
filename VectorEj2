#include <iostream>
using namespace std;

double encontrarMinimo(double a[], int n);
 

int main() {
    int n;
    cin >> n;
    double a[100];
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }
    cout << encontrarMinimo(a, n) << endl;
    return 0;
}

double encontrarMinimo(double a[], int n) {
    double minimo = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] < minimo) {
            minimo = a[i];
        }
    }
    return minimo;
}
