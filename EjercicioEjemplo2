#include <iostream>
#include <cstdlib>
#include <cmath>

using namespace std;

// Prototipos
int menor(int a, int b);
int signo(float a);
int potencia(int n, int m);

int main()
{
    int x, y;
    int opcion;

    do {
        cout << "\t\t Menu \n";
        cout << "\t\t ==== \n";
        cout << "1. Numero menor\n";
        cout << "2. Signo positivo o negativo\n";
        cout << "3. Potencia de numero\n";
        cout << "0. Salir\n";
        cout << "Opcion: ";
        cin >> opcion;

        switch (opcion)
        {
        case 1:
            cout << "Ingrese los numeros a comparar: " << endl;
            cin >> x;
            cin >> y;
            cout << "El numero menor es: " << menor(x, y) << endl;
            break;

        case 2:
            cout << "Ingrese su numero: ";
            cin >> x;
            cout << "El signo es: " << signo(x) << endl;
            break;

        case 3:
            cout << "Ingrese la base y posteriormente la potencia: ";
            cin >> x;
            cin >> y;
            cout << "\nSu resultado es: " << potencia(x, y) << endl;
            break;

        case 0:
            cout << "Salir del menu" << endl;
            break;

        default:
            cout << "ERROR de opcion" << endl;
            break;
        }

        system("pause");
        system("cls");

    } while (opcion != 0);

    return 0;
}

int menor(int a, int b)
{
    if (a < b) {
        return a;
    }
    else {
        return b;
    }
}

int signo(float a)
{
    if (a < 0) {
        return -1;
    }
    else if (a > 0) {
        return 1;
    }
    else {
        return 0;
    }
}

int potencia(int n, int m)
{
    int acum = 1;

    for (int i = 1; i <= m; i++) {
        acum = acum * n;
    }

    return acum;
}
