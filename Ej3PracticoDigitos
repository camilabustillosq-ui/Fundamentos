#include <iostream>
using namespace std;

int main()
{
    int N, digito, contador = 0;

    cout << "Ingrese un numero: ";
    cin >> N;

    int original = N;

    if (N < 0)
    {
        N = -N;
    }

    if (N == 0)
    {
        contador = 1;
    }
    else
    {
        while (N > 0)
        {
            digito = N % 10;

            if (digito % 2 == 0)
            {
                contador = contador + 1;
            }

            N = N / 10;
        }
    }

    cout << "El numero " << original << " tiene " << contador << " digitos pares." << endl;

    return 0;
}
